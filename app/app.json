{
  "expo": {
    "name": "GearDrop",
    "slug": "geardrop",
    "owner": "noir-madlax",
    "version": "1.2.0",
    "scheme": "geardrop",
    "locales": {
      "zh-Hans": {
        "ios": {
          "CFBundleDisplayName": "值de",
          "CFBundleName": "值de"
        },
        "android": {
          "app_name": "值de"
        }
      }
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.100app.geardrop",
      "buildNumber": "12",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#17372F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5EF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#151513",
          "defaultChannel": "price-alerts",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "zh-Hans",
              "de",
              "fr",
              "ja"
            ],
            "android": [
              "en",
              "zh-CN",
              "de",
              "fr",
              "ja"
            ]
          }
        }
      ],
      "expo-background-task"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ead43b0e-5dbf-44a2-838e-f65db29abb30"
      }
    }
  }
}
